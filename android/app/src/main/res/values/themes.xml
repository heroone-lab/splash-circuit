<resources>
    <!-- Splash screen (AndroidX core-splashscreen, works on API 26+) -->
    <style name="Theme.SplashCircuit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SplashCircuit</item>
    </style>
    <style name="Theme.SplashCircuit" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
