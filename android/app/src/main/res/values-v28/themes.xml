<resources>
    <style name="Theme.SplashCircuit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SplashCircuit</item>
    </style>
    <!-- Draw into notch / punch-hole areas; the web UI keeps controls inside CSS safe-area insets. -->
    <style name="Theme.SplashCircuit" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
